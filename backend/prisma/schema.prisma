datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CloudProvider {
  AWS
  AZURE
  GCP
}

enum ResourceStatus {
  RUNNING
  STOPPED
  TERMINATED
  ACTIVE
  INACTIVE
  DELETED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  RESOLVED
  MUTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String?            // Nullable for OAuth accounts
  name             String
  isEmailVerified  Boolean            @default(false)
  emailVerifyToken String?
  resetToken       String?
  resetTokenExpiry DateTime?
  mfaEnabled       Boolean            @default(false)
  mfaSecret        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      UserOrganization[]
  auditLogs        AuditLog[]
}

model Organization {
  id            String             @id @default(uuid())
  name          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   UserOrganization[]
  accounts      CloudAccount[]
  resources     CloudResource[]
  findings      SecurityFinding[]
  k8sClusters   KubernetesCluster[]
  auditLogs     AuditLog[]
  alerts        Alert[]
  billing       BillingSubscription?
  invoices      Invoice[]
  notifications NotificationSetting?
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model CloudAccount {
  id             String          @id @default(uuid())
  organizationId String
  provider       CloudProvider
  name           String
  credentials    String          // Encrypted AES-256 JSON containing keys/secrets/role ARNs
  isValid        Boolean         @default(true)
  lastValidated  DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      CloudResource[]
  findings       SecurityFinding[]
  costs          CostMetric[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CloudResource {
  id             String          @id @default(uuid())
  organizationId String
  accountId      String
  resourceId     String          // Provider-specific ID (arn, resource uri, instance-id)
  name           String
  type           String          // EC2, RDS, S3, ECS, VM, etc.
  region         String
  status         ResourceStatus  @default(ACTIVE)
  metadata       Json            // Store specific properties (IPs, size, engine, etc.)
  costDaily      Float           @default(0.0)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        CloudAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  findings       SecurityFinding[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([accountId, resourceId])
  @@index([type])
  @@index([organizationId])
}

model CostMetric {
  id             String       @id @default(uuid())
  accountId      String
  service        String       // S3, EC2, CloudWatch, etc.
  amount         Float
  date           DateTime     // Day of cost representation
  account        CloudAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, service, date])
  @@index([date])
}

model SecurityFinding {
  id             String          @id @default(uuid())
  organizationId String
  accountId      String
  resourceId     String?         // Optional reference to a discovered resource
  title          String
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  aiExplanation  String?         // Explanation generated by OpenAI
  remediation    String
  ruleId         String          // Standard check code e.g. AWS-IAM-001
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        CloudAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  resource       CloudResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([severity])
  @@index([organizationId])
}

model KubernetesCluster {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  kubeconfig     String         // Encrypted kubeconfig
  status         String         @default("UNREACHABLE")
  metrics        Json?          // Last collected cluster health and metrics
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  ipAddress      String?
  userAgent      String?
  details        Json
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Alert {
  id             String       @id @default(uuid())
  organizationId String
  severity       String       // INFO, WARNING, CRITICAL
  message        String
  acknowledged   Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model BillingSubscription {
  id             String             @id @default(uuid())
  organizationId String             @unique
  stripeCustId   String?
  stripeSubId    String?
  plan           String             @default("FREE") // FREE, STARTUP, ENTERPRISE
  status         SubscriptionStatus @default(TRIALING)
  endsAt         DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  amount         Float
  currency       String       @default("USD")
  status         String       // PAID, UNPAID, VOID
  pdfUrl         String?
  dueDate        DateTime
  paidAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model NotificationSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  emailAlerts    Boolean      @default(true)
  slackWebhook   String?
  discordWebhook String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
